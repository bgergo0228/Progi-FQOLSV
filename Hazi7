//angol abc
#include <stdio.h>

char* feltolt(char tomb[]) {
    for (int i = 0; i < 26; i++) {
        tomb[i] = 'a' + i;
    }
    tomb[26] = '\0';
    return tomb;
}

int main() {
    char tomb[27];
    char* abc = feltolt(tomb);
    printf("%s\n", abc);
    
    return 0;
}


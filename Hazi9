//fájlban lévő egészek rendezése (416h)
#include <stdio.h>
#include <stdlib.h>
int compare(const void *a, const void *b) {
    return (*(int*)a - *(int*)b);
}

int main(int argc, char *argv[]) {
  
    if (argc != 2) {
        return 1;
    }

 
    FILE *file = fopen(argv[1], "r");
    if (file == NULL) {
        fprintf(stderr, "Hiba! %s\n", argv[1]);
        return 1;
    }

   
    int capacity = 10; 
    int count = 0;     
    int *numbers = (int*)malloc(capacity * sizeof(int));
    
    if (numbers == NULL) {
        fprintf(stderr, "Hiba!\n");
        fclose(file);
        return 1;
    }

    int current_number;
    while (fscanf(file, "%d", &current_number) == 1) {
        if (count >= capacity) {
            capacity *= 2;
            int *temp = (int*)realloc(numbers, capacity * sizeof(int));
            if (temp == NULL) {
                fprintf(stderr, "Hiba!\n");
                free(numbers);
                fclose(file);
                return 1;
            }
            numbers = temp;
        }
        numbers[count] = current_number;
        count++;
    }

  
    fclose(file);

    qsort(numbers, count, sizeof(int), compare);
    for (int i = 0; i < count; i++) {
        printf("%d\n", numbers[i]);
    }
    free(numbers);

    return 0;
}


//tömb véletlenszerűen kiválasztott eleme (416f)
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int choice(const int n, const int tomb[]) {
    int rx = rand() % n;
    return tomb[rx];
}

int main() {
    srand(time(NULL));

    int szamok[] = {125, 45, 28, 23, 9, 526, 63, 111, 512, 74, 7, 77, 12};
    int n = sizeof(szamok) / sizeof(szamok[0]);
    int k = choice(n, szamok);
    printf("Random elem: %d\n", k);

    return 0;
}





//shuffle művelet (tömb elemeinek az összekeverése, 416g)
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

void shuffle(int n, int tomb[]) {
    for (int i = n - 1; i >= 1; i--) {
        int j = rand() % (i + 1);
        int temp = tomb[i];
        tomb[i] = tomb[j];
        tomb[j] = temp;
    }
}

int main() {
    srand(time(NULL));
    int li[] = {1, 2, 3, 4, 5, 6, 7, 8};
    int n = sizeof(li) / sizeof(li[0]);

    printf("Eredeti: ");
    for (int i = 0; i < n; i++) {
        printf("%d ", li[i]);
    }
    printf("\n");

    shuffle(n, li);

    printf("Keverve: ");
    for (int i = 0; i < n; i++) {
        printf("%d ", li[i]);
    }
    printf("\n");

    return 0;
}


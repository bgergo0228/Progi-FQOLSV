#include <stdio.h>
#include <stdlib.h>
#include <time.h>

void shuffle(int n, char tomb[]) {
    for (int i = n - 1; i >= 1; i--) {
        int j = rand() % (i + 1);
        char temp = tomb[i];
        tomb[i] = tomb[j];
        tomb[j] = temp;
    }
}

int main() {
    srand(time(NULL));

    const char kisbetuk[] = "abcdefghijklmnopqrstuvwxyz";
    const char nagybetuk[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    const char szamok[] = "0123456789";
    const char specialis[] = ".,;'";
    const char osszes_karakter[] = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.,;'";

    int n_kis = sizeof(kisbetuk) - 1;
    int n_nagy = sizeof(nagybetuk) - 1;
    int n_szam = sizeof(szamok) - 1;
    int n_spec = sizeof(specialis) - 1;
    int n_osszes = sizeof(osszes_karakter) - 1;

    int hossz = 8 + (rand() % 5);

    char jelszo[13];

    jelszo[0] = kisbetuk[rand() % n_kis];
    jelszo[1] = nagybetuk[rand() % n_nagy];
    jelszo[2] = szamok[rand() % n_szam];
    jelszo[3] = specialis[rand() % n_spec];

    for (int i = 4; i < hossz; i++) {
        jelszo[i] = osszes_karakter[rand() % n_osszes];
    }

    jelszo[hossz] = '\0';
    shuffle(hossz, jelszo);
    printf("%s\n", jelszo);

    return 0;
}



//leghosszabb sor (424a)
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main(int argc, char *argv[]) {
    if (argc != 4) {
        return 1;
    }

    int sorok_szama = atoi(argv[1]);
    int min_hossz = atoi(argv[2]);
    int max_hossz = atoi(argv[3]);

    if (min_hossz > max_hossz || min_hossz <= 0) {
        fprintf(stderr, "Hiba!\n");
        return 1;
    }
    
    srand(time(NULL));

    for (int i = 0; i < sorok_szama; i++) {
        int hossz = min_hossz + rand() % (max_hossz - min_hossz + 1);
        
        for (int j = 0; j < hossz; j++) {
            char c;
            if (j == hossz - 1) {
                c = 33 + rand() % (126 - 33 + 1);
            } else {
                c = 32 + rand() % (126 - 32 + 1);
            }
            printf("%c", c);
        }
        printf("\n");
    }

    return 0;
}



